# Version string recorded against every prediction, so an old result stays interpretable
# after a retrain.
MODEL_VERSION=effnetb3-v5-rsna

# Validation-set MAE in months (model repo's MEMORY.md section 5). The UI shows this as the
# "±" margin next to the estimate (TOR FR-18), so it must be the real measured figure.
MAE_MONTHS=8.12

# Share of validation predictions within 12 months — shown alongside MAE so the UI doesn't
# imply a bound the model doesn't have.
ACCURACY_WITHIN_12M=0.768

# Path to the ONNX export (see convert_to_onnx.py). Not committed — see README.
MODEL_PATH=models/bone_age.onnx
